# Yjs WebSocket + Snapshot Server Configuration

# Server binding
PORT=1889
HOST=0.0.0.0

# Path to session token files (same dir as auth.php)
# Each file is named by the token and contains JSON: { "username": "...", "expires": <unix_timestamp> }
TOKEN_DIR=/var/www/instrumenta/data/session_tokens/

# y-leveldb path for live document state
LEVELDB_PATH=./data/yjs-leveldb

# SQLite DB path for snapshot history only
SQLITE_PATH=./data/yjs-snapshots.db

# Set GC=false if you want to preserve deleted content for snapshot diffs
GC=true

# Snapshot scheduling (milliseconds)
# MIN: quiet-period debounce — snapshot taken this long after the last edit
# MAX: cap — snapshot taken at least this often during continuous editing
SNAPSHOT_MIN_INTERVAL=600000
SNAPSHOT_MAX_INTERVAL=3600000

# Optional: allow unauthenticated connections (for dev/testing only)
ALLOW_ANONYMOUS=false
